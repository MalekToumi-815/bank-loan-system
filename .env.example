# Internal service authentication. Generate a long, random value for deployments.
INTERNAL_SHARED_SECRET=replace-with-a-random-internal-secret

# Base64-encoded signing key for JWT tokens. Use a unique production key.
JWT_SECRET=replace-with-a-base64-encoded-jwt-secret
ACCESS_TOKEN_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=604800000

# Angular origin used by gateway CORS configuration.
# Docker Compose: http://localhost
# Angular development server: http://localhost:4200
ANGULAR_APP_URL=http://localhost

# Spring profile loaded from Consul KV.
SPRING_PROFILES_ACTIVE=dev

# SMTP provider used by notification-service.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=replace-with-mailtrap-username
MAILTRAP_PASSWORD=replace-with-mailtrap-password